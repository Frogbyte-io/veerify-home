---
import { type SiteDictionary } from '../i18n/site'

interface Props {
  t: SiteDictionary['faq']
}

const { t } = Astro.props
---

<section id="faq" class="border-t border-border/50 py-28">
  <div class="mx-auto max-w-3xl px-6 lg:px-8">
    <div class="mb-12 text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-primary">{t.sectionLabel}</p>
      <h2 class="font-display text-4xl font-bold tracking-tight lg:text-5xl">{t.heading}</h2>
    </div>

    <div class="divide-y divide-border/60 rounded-2xl border border-border/60 bg-card">
      {t.items.map(item => (
        <details class="group px-6 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
            {item.question}
            <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
