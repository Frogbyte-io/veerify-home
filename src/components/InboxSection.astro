---
import { type SiteDictionary } from '../i18n/site'

interface Props {
  t: SiteDictionary['inbox']
}

const { t } = Astro.props

const behaviorLabels: Record<string, string> = {
  mail: t.mock.behaviorMail,
  helpdesk: t.mock.behaviorHelpdesk,
  catchAll: t.mock.catchAll,
}

const pointIcons = [
  `<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>`,
  `<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>`,
  `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  `<polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/>`,
  `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
]
---

<section id="inbox" class="overflow-hidden border-t border-border/50 py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-primary">{t.sectionLabel}</p>
        <h2 class="font-display text-4xl font-bold tracking-tight lg:text-5xl">
          {t.headingTop}<br />
          <em class="italic text-primary">{t.headingAccent}</em>
        </h2>
        <p class="mt-4 max-w-lg text-lg leading-relaxed text-muted-foreground">{t.intro}</p>

        <ul class="mt-10 space-y-6">
          {t.points.map((point, index) => (
            <li class="flex gap-4">
              <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/20">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <Fragment set:html={pointIcons[index]} />
                </svg>
              </div>
              <div>
                <h3 class="mb-1 font-semibold leading-snug">{point.title}</h3>
                <p class="text-sm leading-relaxed text-muted-foreground">{point.desc}</p>
              </div>
            </li>
          ))}
        </ul>

        <a
          href="https://app.veerify.io/get-started"
          class="mt-10 inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:opacity-90 hover:-translate-y-0.5"
        >
          {t.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="relative" aria-hidden="true">
        <div class="pointer-events-none absolute -inset-8 rounded-full bg-primary/10 blur-[100px]"></div>

        <div class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-2xl shadow-black/10">
          <div class="flex items-center justify-between border-b border-border/70 px-5 py-3.5">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
            </div>
            <span class="text-xs font-semibold">{t.mock.title}</span>
            <span class="w-10"></span>
          </div>

          <div class="border-b border-border/70 p-5">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">{t.mock.addressesLabel}</p>
            <div class="space-y-2">
              {t.mock.addresses.map(address => (
                <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-border/60 bg-background/60 px-3 py-2">
                  <div class="min-w-0">
                    <p class="truncate font-mono text-xs">{address.address}</p>
                    {address.forward && (
                      <p class="mt-0.5 truncate text-[11px] text-muted-foreground">{t.mock.forwardsTo} {address.forward}</p>
                    )}
                  </div>
                  <span
                    class:list={[
                      'rounded-full px-2 py-0.5 text-[10px] font-semibold',
                      address.behavior === 'helpdesk' ? 'bg-primary/15 text-primary' : 'bg-secondary text-muted-foreground',
                    ]}
                  >
                    {behaviorLabels[address.behavior]}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="p-5">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">{t.mock.conversationsLabel}</p>
            <div class="divide-y divide-border/60">
              {t.mock.conversations.map(conversation => (
                <div class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-secondary text-[11px] font-semibold">
                    {conversation.from.split(' ').map(part => part[0]).join('')}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <p class="truncate text-sm font-semibold">{conversation.from}</p>
                      <span class="shrink-0 text-[11px] text-muted-foreground">{conversation.time}</span>
                    </div>
                    <p class="truncate text-xs text-muted-foreground">{conversation.subject}</p>
                    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                      <span class="rounded bg-secondary px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">{conversation.to}</span>
                      {conversation.badge && (
                        <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">{conversation.badge}</span>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
